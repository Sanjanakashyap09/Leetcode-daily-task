import os
import shutil

# Define folders for difficulty levels
difficulty_folders = {
    "easy": "solutions/easy",
    "medium": "solutions/medium",
    "hard": "solutions/hard"
}

# Make sure folders exist
for folder in difficulty_folders.values():
    os.makedirs(folder, exist_ok=True)

# Example mapping: problem filename → difficulty
# You can expand this dictionary as you solve more problems
problem_difficulty = {
    "two-sum.cpp": "easy",
    "palindrome-number.py": "easy",
    "add-two-numbers.cpp": "medium",
    "coin-change.cpp": "medium",
    "smallest-divisible-digit-product.cpp": "hard",
    "word-ladder.cpp": "hard"
}

# Move files into correct folders
for filename, difficulty in problem_difficulty.items():
    src = f"solutions/{filename}"
    dest = f"{difficulty_folders[difficulty]}/{filename}"
    if os.path.exists(src):
        shutil.move(src, dest)
        print(f"Moved {filename} → {difficulty}")
    else:
        print(f"File {filename} not found in solutions/")
